# Clerk — https://dashboard.clerk.com
# See docs/clerk-dashboard-setup.md for OAuth-only Dashboard configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Do NOT set CLERK_SIGN_IN_URL to the Account Portal hosted URL.
# Sign-in uses in-app modal (GaldrSignInButton); /sign-in is callback-only.

# Neon Postgres connection string (required for votes, comments, saved staves)
DATABASE_URL=

# After setting DATABASE_URL, create tables once:
#   npm run db:push
